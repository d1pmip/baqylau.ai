/* Baqylau Soft Bento — same palette, refined chrome */
QMainWindow { background: #F4F6F0; font-family: "Segoe UI", "Inter", sans-serif; }
QWidget { font-family: "Segoe UI", "Inter", sans-serif; }
QLabel { color: #1A1A1A; }
QLabel#AppTitle { font-size: 28px; font-weight: 900; letter-spacing: 0.5px; }
QLabel#AppSub { font-size: 13px; color: #6B6B6B; }
QLabel#CardTitle { font-size: 16px; font-weight: 900; color: #1A1A1A; letter-spacing: 0.3px; }
QLabel#RiskBig { font-size: 40px; font-weight: 900; letter-spacing: 0.5px; }
QLabel#VideoLabel {
  background: #1E1E1E; color: #FFFFFF;
  border-radius: 14px; border: 2px solid #2E2E2E;
  font-size: 14px;
}
QFrame[card="true"] { border-radius: 20px; border: none; }
QFrame#VideoCard { background: #1E1E1E; border-radius: 20px; }
QFrame#VideoCard QLabel { color: #FFFFFF; }
QFrame#EegCard { background: #D8D4FF; border-radius: 20px; }
QFrame#FatigueCard { background: #D4F5A6; border-radius: 20px; }
QFrame#AlertsCard { background: #FFF4A3; border-radius: 20px; }
QFrame#ControlCard { background: #FFFFFF; border-radius: 20px; border: 1px solid #E8E8E8; }
QFrame#ExamCard { background: #FFFFFF; border-radius: 20px; border: 2px solid #D8D4FF; }
QFrame#ExamNavCard { background: #FFFFFF; border-radius: 20px; border: 2px solid #D8D4FF; }
QFrame#HeaderCard { background: #FFFFFF; border-radius: 20px; border: 1px solid #E8E8E8; }
QLabel#Avatar {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #D8D4FF, stop:1 #D4F5A6);
  color: #1A1A1A; font-weight: 900; font-size: 16px;
  border-radius: 18px; min-width: 36px; min-height: 36px; max-width: 36px; max-height: 36px;
}
QLabel#Badge {
  background: #D4F5A6; color: #1A3A1A; font-weight: 900; font-size: 14px;
  border-radius: 14px; padding: 9px 16px;
}
QLabel#Badge.paused { background: #FFF4A3; color: #5A4A00; }
QLabel#Dot { font-size: 16px; font-weight: 900; }
QPushButton {
  border: none; border-radius: 12px; padding: 10px 18px;
  font-size: 13px; font-weight: 800; color: #1A1A1A;
}
QPushButton:pressed { background: #E8E8E8; }
QPushButton:disabled { background: #E4E4E4; color: #999999; }
QPushButton#BtnSnap { background: #D4F5A6; }
QPushButton#BtnSnap:hover { background: #CDF3A6; }
QPushButton#BtnPause { background: #FFF4A3; }
QPushButton#BtnPause:hover { background: #FFF3B0; }
QPushButton#BtnQuit { background: #FFC1C1; }
QPushButton#BtnQuit:hover { background: #FFB5B5; }
QPushButton#BtnQuit:pressed { background: #FFA8A8; }
QProgressBar { background: rgba(255,255,255,0.65); border: none; border-radius: 9px; height: 18px; text-align: center; font-size: 11px; font-weight: 800; color: #1A1A1A; }
QProgressBar::chunk { border-radius: 9px; background: #1A1A1A; }
QProgressBar#FocusBar::chunk { background: #2E7D32; }
QProgressBar#StressBar::chunk { background: #C62828; }
QProgressBar#FatigueBar::chunk { background: #6A1B9A; }
QListWidget { background: rgba(255,255,255,0.6); border: none; border-radius: 14px; font-size: 12px; padding: 6px; }
QListWidget::item { border-radius: 8px; padding: 6px 10px; margin: 2px; }
QListWidget::item:selected { background: #D8D4FF; color: #1A1A1A; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px; }
QScrollBar::handle:vertical { background: #CFCFCF; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #1A1A1A; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollArea { border: none; background: transparent; }
QScrollArea QWidget { background: transparent; }
QScrollArea QRadioButton#ExamOpt[picked="true"] { background: #D8D4FF; }
QRadioButton { font-size: 14px; color: #1A1A1A; spacing: 10px; padding: 6px 4px; }
QRadioButton::indicator { width: 20px; height: 20px; border-radius: 11px; border: 2px solid #BDBDBD; background: #FFFFFF; }
QRadioButton::indicator:hover { border: 2px solid #1A1A1A; }
QRadioButton::indicator:checked { border: 2px solid #1A1A1A; background: qradialgradient(cx:0.5, cy:0.5, radius:0.5, fx:0.5, fy:0.5, stop:0 #1A1A1A, stop:0.45 #1A1A1A, stop:0.5 #FFFFFF, stop:1 #FFFFFF); }
QLabel#ExamQ { font-size: 17px; font-weight: 800; color: #1A1A1A; margin-top: 10px; }
/* Вопрос без картинки: крупнее, занимает всю ширину карточки */
QLabel#ExamQBig { font-size: 20px; font-weight: 900; color: #1A1A1A; margin-top: 12px; }
QLabel#ExamMeta { font-size: 13px; font-weight: 600; color: #6B6B6B; }
/* Чёрный медиа-бокс как .cam на сайте: скругление 14, бейдж статуса справа */
QFrame#MediaBox { background: #1E1E1E; border-radius: 14px; }
QFrame#MediaBox QLabel { color: #FFFFFF; }
QLabel#MediaBadge { background: #E4E4E4; color: #1A1A1A; font-weight: 900; font-size: 12px;
  border-radius: 10px; padding: 4px 12px; }
QLabel#MediaBadge[done="true"] { background: #D4F5A6; color: #1A3A1A; }
/* Картинка вопроса: прозрачный фон, без лишней рамки — бокс обнимает фото */
QLabel#ExamImg { background: transparent; border: none; }
/* Сегмент-бар риска как .track на сайте */
QFrame#RiskSeg { background: #E4E4E4; border-radius: 4px; min-height: 8px; max-height: 8px; }
QRadioButton#ExamOpt { font-size: 16px; font-weight: 600; color: #1A1A1A; border-radius: 12px; padding: 10px 12px; border: 1px solid transparent; background: transparent; }
QRadioButton#ExamOpt:hover { background: #FFFFFF; border: 1px solid #D8D4FF; }
QRadioButton#ExamOpt:pressed { background: #ECECFB; border: 1px solid #D8D4FF; }
QRadioButton#ExamOpt[picked="true"] { background: #D8D4FF; font-weight: 900; color: #000000; }
/* Точки-индикаторы: серые кружки, активная — зелёный овал (палитра без изменений) */
QPushButton#ExamDot { background: #CFCFCF; border: none; border-radius: 5px;
  min-width: 10px; max-width: 10px; min-height: 10px; max-height: 10px; padding: 0px; }
QPushButton#ExamDot[active="true"] { background: #2E7D32; border-radius: 5px;
  min-width: 26px; max-width: 26px; min-height: 10px; max-height: 10px; }
QPushButton#ExamDot:hover { border: 1px solid #6B6B6B; }
/* Мягкая подсветка границ навигации при наведении (без жёсткого чёрного) */
QToolTip { background: #1E1E1E; color: #FFFFFF; border: none; border-radius: 8px; padding: 6px 10px; }
